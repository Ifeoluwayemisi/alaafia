NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:3000

DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

JWT_SECRET=
GOOGLE_CLIENT_ID=

# Email verification SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Self-hosted Whisper speech-to-text service (see /whisper-service)
WHISPER_SERVICE_URL=http://localhost:8001
WHISPER_SERVICE_TOKEN=
# Timeout must exceed worst-case transcription time; WebM/Opus on CPU can
# take ~30s or more depending on load.
WHISPER_TIMEOUT_MS=60000

NHFR_API_KEY=

# Payments — provider-agnostic gateway selection: 'wema' | 'mock' (unset = disabled)
PAYMENT_GATEWAY=
# ALATPay (Wema Bank merchant gateway) — values from the merchant dashboard.
# Docs: https://docs.alatpay.ng  (Secret/Webhook keys are SECRETS; never commit)
ALATPAY_BASE_URL=https://apibox.alatpay.ng
ALATPAY_BUSINESS_ID=
ALATPAY_SECRET_KEY=
ALATPAY_WEBHOOK_SECRET=
ALATPAY_PUBLIC_KEY=
ALATPAY_TIMEOUT_MS=30000

# Platform take-rate (basis points; 300 = 3%). 0 = charges OFF.
# Fees apply ONLY to SUPPORT_CONTRIBUTION amounts >= threshold, never to
# CARE_PAYMENT. ALATPay processor fees are absorbed by the platform.
PLATFORM_FEE_BPS=0
PLATFORM_FEE_THRESHOLD_MINOR=0

# Multilingual AI voice output
YARNGPT_API_KEY=
YARNGPT_BASE_URL=https://yarngpt.ai
