# Whisper model size: tiny | base | small | medium | large-v3
# `small` is the Alafia default (see README for the trade-off analysis).
WHISPER_MODEL=small

# cpu | cuda | auto
WHISPER_DEVICE=cpu

# int8 works best on CPU; use float16 on GPU.
WHISPER_COMPUTE_TYPE=int8

# Shared secret for service-to-service auth. Leave empty to disable auth
# (acceptable when the service is only reachable on localhost).
WHISPER_SERVICE_TOKEN=

# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=25

LOG_LEVEL=INFO
